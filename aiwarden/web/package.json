{
  "name": "aiwarden-console",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo": "python scripts/demo.py",
    "e2e": "node e2e/drive.mjs",
    "build:demo": "tsc --noEmit -p tsconfig.json && vite build --mode demo --outDir dist --emptyOutDir"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "cmdk": "1.1.1",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
