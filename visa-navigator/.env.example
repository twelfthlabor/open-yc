# Optional. Without a key, passport reading falls back to the MRZ text you type or paste,
# document checks use the details you type, and drafts use built-in templates.
ANTHROPIC_API_KEY=

# Optional: WhatsApp reminders through Twilio (https://www.twilio.com/docs/whatsapp).
# Use either the account auth token or an API key + secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# Sender, e.g. the Twilio sandbox number whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Approved message template with variables {{1}} (title) and {{2}} (text).
# Without it, messages are free-form and only arrive within 24 hours of you messaging the sender.
TWILIO_CONTENT_SID=

# ---- Hosted service (npm run dev:service) ----
# 32 random bytes, base64. Encrypts customer data at rest; keep it safe, losing it loses the data.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVICE_KEY=
# The site's public address, used in sign-in links and to check where requests come from.
PUBLIC_URL=http://localhost:5173
# Your console password. AGENT_TOKEN is optional (for a future filing agent on your PC).
OPERATOR_PASSWORD=
AGENT_TOKEN=
# Sign-in emails (https://resend.com). Without a key in development, links are printed in the terminal.
RESEND_API_KEY=
MAIL_FROM=Visa Navigator <signin@your-domain>
# Passport reads allowed per day across all customers.
AI_DAILY_CAP=300
# The header your proxy sets to the client's address, used by the sign-in and console login rate limits.
# Leave it empty when the server faces the internet directly: forwarding headers are then ignored, since anyone can send them.
# On Fly.io set TRUST_PROXY_HEADER=fly-client-ip. Without it every request comes from Fly's proxy address,
# so all customers share one limit (20 sign-in emails or 10 console logins an hour, for everyone).
# Only name a header your proxy overwrites; for x-forwarded-for the last entry (the one the proxy appended) is used.
TRUST_PROXY_HEADER=
