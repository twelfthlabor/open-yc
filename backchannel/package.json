{
  "name": "backchannel",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "One group chat to hear and steer your Claude Code and Codex agents.",
  "bin": {
    "backchannel": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "npm run build && node src/cli.ts serve",
    "serve": "node src/cli.ts serve",
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/drive.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "^1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
